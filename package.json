{
  "name": "atomlab",
  "private": true,
  "version": "1.0.0",
  "description": "ATOMLAB — виртуальная химическая лаборатория (7–11 класс)",
  "author": "ATOMLAB",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:dev:attach": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "desktop:icon": "node scripts/prepare-desktop-icon.mjs",
    "desktop:build": "npm run desktop:icon && npm run build && electron-builder --win portable zip --x64",
    "desktop:build:installer": "npm run desktop:icon && npm run build && electron-builder --win nsis --x64",
    "electron:build": "npm run desktop:build",
    "lint": "eslint .",
    "pubchem:sync": "tsx scripts/pubchem-sync-geometry.ts",
    "pubchem:sync:fast": "tsx scripts/pubchem-sync-geometry.ts",
    "preview": "vite preview",
    "validate:learn": "tsx scripts/validate-learn.ts",
    "validate:lab": "tsx scripts/validate-lab-synthesis.ts",
    "learn:nanobanana-prompts": "tsx scripts/export-nanobanana-prompts.ts",
    "learn:capture-refs": "tsx scripts/capture-learn-refs.ts",
    "learn:generate-all": "npm run build && npm run learn:nanobanana-prompts && npm run learn:capture-refs",
    "learn:audit-visuals": "tsx scripts/audit-learn-visuals.ts",
    "learn:prepare-slides": "node scripts/prepare-learn-slides.mjs",
    "learn:prepare-cyber": "node scripts/prepare-cyber-dashboard.mjs",
    "learn:generate-element-profiles": "node scripts/generate-element-life-profiles.mjs",
    "learn:prepare-element-life": "node scripts/generate-element-life-profiles.mjs && node scripts/prepare-element-life-images.mjs",
    "learn:fetch-placeholders": "node scripts/fetch-learn-placeholders.mjs",
    "wasm:build": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.184.0",
    "gsap": "^3.15.0",
    "periodic-table-data": "^1.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.atomlab.app",
    "productName": "ATOMLAB",
    "copyright": "Copyright © ATOMLAB",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.wasm",
      "**/*worker*.js"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-x64.${ext}",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  }
}
