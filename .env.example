# --- Локальная разработка (npm run dev) ---
# Скопируйте: copy .env.example .env  (Windows: copy .env.example .env)

# --- Локальный Python-учитель (Ollama + RAG + Edge TTS) ---
# 1) ollama pull llama3.2 && ollama serve
# 2) pip install -r teacher_service/requirements.txt
# 3) npm run teacher:dev  (порт 8765)
# VITE_TEACHER_SERVICE_URL=http://127.0.0.1:8765
# Для dev без CORS можно не задавать URL — Vite проксирует /teacher-api
# TEACHER_SERVICE_PORT=8765
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# OpenAI — полноценный ИИ-учитель (любые вопросы по химии)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Голос учителя (Articulate Tutor Natural из video/) ---
# auto = клон Articulate (ElevenLabs) → Edge Neural → OpenAI
# clone = только клон Articulate Tutor — максимально похож на образец MP3
# edge = Microsoft Neural (fallback без ElevenLabs)
LEARN_TTS_PROVIDER=auto

# ElevenLabs — точный клон голоса Articulate Tutor Natural
# 1) npm run prepare:teacher-voice
# 2) ELEVENLABS_API_KEY=sk_... npm run clone:teacher-voice
# 3) Добавьте voice_id в .env:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Microsoft Edge Neural (fallback если клон недоступен)
# EDGE_TTS_VOICE_RU=ru-RU-DmitryNeural  (мужской, как video/male-voice-for-answering-machine.mp3)
# EDGE_TTS_VOICE_EN=en-US-GuyNeural

# OpenAI fallback (если Edge недоступен)
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-03-20
OPENAI_TTS_VOICE_RU=onyx
OPENAI_TTS_VOICE_EN=onyx

# Опционально отдельный URL (иначе берётся из VITE_LEARN_CHAT_URL → /tts)
# VITE_LEARN_TTS_URL=https://your-project.vercel.app/api/learn/tts

# CORS для продакшен-API (Vercel): через запятую
# ALLOWED_ORIGINS=https://sadykoffalan2105-dev.github.io,https://your-user.github.io

# --- Сборка сайта (GitHub Pages / Electron) ---
# URL serverless API на Vercel (после деплоя api/learn/chat)
# VITE_LEARN_CHAT_URL=https://your-project.vercel.app/api/learn/chat

# Базовый путь для GitHub Pages (репозиторий atomlab)
# VITE_BASE=/atomlab/
