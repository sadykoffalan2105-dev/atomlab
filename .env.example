# --- Локальная разработка (npm run dev) ---
# Скопируйте: copy .env.example .env  (Windows: copy .env.example .env)

# OpenAI — полноценный ИИ-учитель (любые вопросы по химии)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Голос учителя (максимально «живой») ---
# auto = сначала Microsoft Edge Neural (лучший RU), затем OpenAI
# edge = только Microsoft Neural (бесплатно, нативный русский Dmitry/Svetlana)
# openai = только OpenAI TTS
LEARN_TTS_PROVIDER=auto

# Microsoft Edge Neural (по умолчанию: ru-RU-DmitryNeural, en-US-JennyNeural)
# EDGE_TTS_VOICE_RU=ru-RU-DmitryNeural
# EDGE_TTS_VOICE_RU=ru-RU-SvetlanaNeural
# EDGE_TTS_VOICE_EN=en-US-JennyNeural

# OpenAI fallback (если Edge недоступен)
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-03-20
OPENAI_TTS_VOICE_RU=marin
OPENAI_TTS_VOICE_EN=cedar

# Опционально отдельный URL (иначе берётся из VITE_LEARN_CHAT_URL → /tts)
# VITE_LEARN_TTS_URL=https://your-project.vercel.app/api/learn/tts

# CORS для продакшен-API (Vercel): через запятую
# ALLOWED_ORIGINS=https://sadykoffalan2105-dev.github.io,https://your-user.github.io

# --- Сборка сайта (GitHub Pages / Electron) ---
# URL serverless API на Vercel (после деплоя api/learn/chat)
# VITE_LEARN_CHAT_URL=https://your-project.vercel.app/api/learn/chat

# Базовый путь для GitHub Pages (репозиторий atomlab)
# VITE_BASE=/atomlab/
