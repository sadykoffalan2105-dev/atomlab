{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atomlab-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "draw-mode-preview",
      "runtimeExecutable": "npx",
