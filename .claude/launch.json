        "tsx",
        "scripts/brain/image-mock-server.mts",
        "--port=8797",
        "--vite=4837"
      ],
      "port": 4837
    },
    {
      "name": "innoweek",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4890",
        "--bind",
        "127.0.0.1",
        "--directory",
        "public/innoweek"
      ],
      "port": 4890
    }
  ]
}
