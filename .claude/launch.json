{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atomlab-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "draw-mode-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/brain/image-mock-server.mts",
        "--port=8797",
        "--vite=4837"
      ],
      "port": 4837
    },
    {
      "name": "innoweek",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4890",
        "--bind",
        "127.0.0.1",
        "--directory",
        "public/innoweek"
      ],
      "port": 4890
    },
    {
      "name": "atomlab-dist-check",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        ".tmp/dist-speed4",
        "--base",
        "/atomlab/",
        "--port",
        "4896",
        "--strictPort"
      ],
      "port": 4896
    },
    {
      "name": "atomlab-dist-orig",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        ".tmp/dist-orig",
        "--base",
        "/atomlab/",
        "--port",
        "4897",
        "--strictPort"
      ],
      "port": 4897
    }
  ]
}
